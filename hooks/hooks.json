{
  "description": "Grok-native Honcho memory hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; bash \"$ROOT/scripts/ensure-deps.sh\" && bun run \"$ROOT/hooks/session-start.ts\"'",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; bash \"$ROOT/scripts/ensure-deps.sh\" && bun run \"$ROOT/hooks/session-end.ts\"'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; bash \"$ROOT/scripts/ensure-deps.sh\" && bun run \"$ROOT/hooks/user-prompt.ts\"'",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"${GROK_PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}\"; bash \"$ROOT/scripts/ensure-deps.sh\" && bun run \"$ROOT/hooks/stop.ts\"'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
